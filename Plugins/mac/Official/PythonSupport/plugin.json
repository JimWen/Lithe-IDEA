{
  "schemaVersion": 1,
  "id": "dev.lithe.plugin.python-support",
  "displayName": "Python Support",
  "version": "0.3.1",
  "apiVersion": 1,
  "hostCompatibility": {
    "minimum": "0.3.1",
    "maximumExclusive": "0.4.0"
  },
  "vendor": {
    "id": "dev.lithe",
    "displayName": "Lithe",
    "signatureRequirement": "sameTeamAsHost"
  },
  "entrypoint": {
    "kind": "nativeBundle",
    "bundleIdentifier": "dev.lithe.plugin.python-support.bundle",
    "principalClass": "LithePythonSupportPluginEntrypoint",
    "bundlePath": "PythonSupport.bundle"
  },
  "modules": [
    {
      "id": "dev.lithe.language.python.execution",
      "displayName": "Python Execution",
      "scope": "workspace",
      "defaultState": "enabled",
      "activationPolicy": "onDemand",
      "sleepPolicy": {
        "kind": "whenIdle",
        "afterSeconds": 600
      },
      "moduleDependencies": [
        "dev.lithe.workspace"
      ],
      "capabilityDependencies": [],
      "providedCapabilities": [
        "dev.lithe.capability.language.python.debug",
        "dev.lithe.capability.language.python.execution",
        "dev.lithe.capability.language.python.testing"
      ],
      "contributions": [],
      "required": false
    },
    {
      "id": "dev.lithe.language.python.language-server",
      "displayName": "Python Language Server",
      "scope": "workspace",
      "defaultState": "enabled",
      "activationPolicy": "onDemand",
      "sleepPolicy": {
        "kind": "whenIdle",
        "afterSeconds": 600
      },
      "moduleDependencies": [
        "dev.lithe.workspace"
      ],
      "capabilityDependencies": [],
      "providedCapabilities": [
        "dev.lithe.capability.language.python.language-server"
      ],
      "contributions": [],
      "required": false
    }
  ],
  "languageSupports": [
    {
      "id": "python",
      "displayName": "Python",
      "fileExtensions": [
        "py",
        "pyi",
        "pyw"
      ],
      "fileNames": [],
      "projectFileNames": [
        "pyproject.toml",
        "pytest.ini",
        "requirements.txt",
        "setup.cfg",
        "setup.py"
      ],
      "languageServerModuleID": "dev.lithe.language.python.language-server",
      "executionModuleID": "dev.lithe.language.python.execution",
      "testingModuleID": "dev.lithe.language.python.execution",
      "debugModuleID": "dev.lithe.language.python.execution"
    }
  ]
}
